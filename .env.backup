# ---------------------------------------------------------------------------
# Roofing Platform - environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Database. Development default = local SQLite file (zero external setup).
# For production point this at PostgreSQL, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/roofing?schema=public"
# and run: npm run db:use-postgres  (flips the Prisma provider) then
#   prisma migrate deploy
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="m9tbP23ygYL7ACBJxe8H5uIKnTvfhlRFj4EiD6sWqS1GwprV"
AUTH_TRUST_HOST=true

# Absolute public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Uploads directory (relative to project root) for the media library
UPLOADS_DIR="public/uploads"

